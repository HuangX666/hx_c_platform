# Supply the actual SDK triplet/sysroot; no libc or board is inferred.
set(CMAKE_SYSTEM_NAME Linux)

if(NOT DEFINED HX_OS_TARGET_PROCESSOR OR
	NOT DEFINED HX_OS_CROSS_PREFIX OR NOT DEFINED HX_OS_SYSROOT)
	message(FATAL_ERROR
		"Set HX_OS_TARGET_PROCESSOR, "
		"HX_OS_CROSS_PREFIX and HX_OS_SYSROOT")
endif()

set(CMAKE_SYSTEM_PROCESSOR "${HX_OS_TARGET_PROCESSOR}")
set(CMAKE_C_COMPILER "${HX_OS_CROSS_PREFIX}gcc")
set(CMAKE_CXX_COMPILER "${HX_OS_CROSS_PREFIX}g++")
set(CMAKE_SYSROOT "${HX_OS_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${HX_OS_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
	HX_OS_TARGET_PROCESSOR HX_OS_CROSS_PREFIX HX_OS_SYSROOT)
