# Initial-cache profile for a small C-only deployment. Use -C with a fresh
# build directory; command-line -D options after -C can selectively re-enable.
foreach(module IN ITEMS NETWORK CARES LOOP IPC KCP THREAD_POOL DELAYED_TASKS
	QUEUES
	MEMORY_POOLS
	ICONV CONFIG CONTAINERS COROUTINES STACKFUL_COROUTINES COROUTINE_IO
	SYSINFO LIBRARY FILE_UTILS STREAM ENCODING LINE_READER
	BUFFERED_FILE ENV PATHS
	THREAD_EX PIPE NET_OPTIONS POSITIONED_IO FILE_INFO BOM TEXT_NUMBER
	CONFIG_SERIALIZE CODEC PERSISTENT_QUEUE HTTP URL CLI TEMP SERIAL
	SHARED_MEMORY UNICODE COMPRESSION REGEX ONCE FRAME
	TIMER RANDOM CRYPTO TLS ARCHIVE VIRTUAL_MEMORY FILE_EXTRA WATCH LOOP_FD
	SYSTEM_UTILS
	PROCESS
	LOCAL_SOCKETS DUPLEX_PIPE REGISTRY WINDOWS_VERSION WINDOWS_DESKTOP
	NATIVE_INTEROP SLEEP_INHIBIT LINUX_DESKTOP PERFORMANCE_REQUEST
	OBFUSCATION CALENDAR TEXT_LOOKUP BITSTREAM SIGNALS PARAMETERS
	PREPROCESSOR SETTINGS PROFILER
	WIDE_MATH PRECISE_WAIT LEXER PROCEDURES VARIANT FORMAT
	CJSON LIBYAML MINIXML INIH TOMLC)
	set(HX_OS_ENABLE_${module} OFF CACHE BOOL "Excluded by minimal profile")
endforeach()

set(HX_OS_BUILD_TESTS OFF CACHE BOOL "Build contract tests")
set(HX_OS_BUILD_EXAMPLES OFF CACHE BOOL "Build examples")
set(HX_OS_BUILD_BENCHMARKS OFF CACHE BOOL "Build microbenchmarks")
