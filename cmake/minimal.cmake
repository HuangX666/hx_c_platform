# Initial-cache profile for a small C-only deployment. Use -C with a fresh
# build directory; command-line -D options after -C can selectively re-enable.
foreach(module IN ITEMS NETWORK LOOP THREAD_POOL DELAYED_TASKS MEMORY_POOLS
	ICONV CONFIG CONTAINERS COROUTINES STACKFUL_COROUTINES COROUTINE_IO
	SYSINFO LIBRARY FILE_UTILS ENV PATHS
	THREAD_EX PIPE NET_OPTIONS POSITIONED_IO FILE_INFO BOM TEXT_NUMBER
	CONFIG_SERIALIZE
	TIMER RANDOM VIRTUAL_MEMORY FILE_EXTRA WATCH LOOP_FD SYSTEM_UTILS
	PROCESS
	LOCAL_SOCKETS DUPLEX_PIPE REGISTRY SLEEP_INHIBIT PERFORMANCE_REQUEST
	OBFUSCATION CALENDAR TEXT_LOOKUP BITSTREAM SIGNALS SETTINGS PROFILER
	WIDE_MATH PRECISE_WAIT LEXER PROCEDURES VARIANT FORMAT
	CJSON LIBYAML MINIXML INIH TOMLC)
	set(HX_OS_ENABLE_${module} OFF CACHE BOOL "Excluded by minimal profile")
endforeach()
set(HX_OS_BUILD_TESTS OFF CACHE BOOL "Build contract tests")
set(HX_OS_BUILD_EXAMPLES OFF CACHE BOOL "Build examples")
set(HX_OS_BUILD_BENCHMARKS OFF CACHE BOOL "Build microbenchmarks")
